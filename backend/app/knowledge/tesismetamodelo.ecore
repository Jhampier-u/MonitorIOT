  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="ApplicationType">
    <eLiterals name="Web"/>
    <eLiterals name="Mobile" value="1"/>
    <eLiterals name="Embedded" value="2"/>
    <eLiterals name="Desktop" value="3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="API" eSuperTypes="#//Resource">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="instructions" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="returnDataFormatType" eType="#//DataFormatType"
        defaultValueLiteral="JSON"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="containsParameter" upperBound="-1"
        eType="#//Parameter" containment="true"/>
