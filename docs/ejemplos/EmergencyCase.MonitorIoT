<?xml version="1.0" encoding="UTF-8"?>
<MonitorIoT:MonitoringArchitectureModel xmlns:MonitorIoT="http://www.uazuay.edu.ec/MonitorIoT" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmi:version="2.0" name="Emergency management system monitoring architecture" description="Multi-layer (edge, fog, cloud) monitoring architecture for an older adult who lives alone: home environment and heart rate monitoring with a daily health summary in the cloud. Based on the illustrative case of Erazo-Garzon et al. (IEEE Access, 2022)." author="Asistente Monitor-IoT">
  <containsEntity xsi:type="MonitorIoT:PhysicalEntity" isPartOf="//@containsIoTSystem.0/@containsIoTSubSystem.0" id="1" name="House" description="House where the older adult lives.">
    <containsComputingNode xsi:type="MonitorIoT:FogNode" isPartOf="//@containsIoTSystem.0/@containsIoTSubSystem.0 //@containsIoTSystem.0/@containsIoTSubSystem.1" id="2" name="HPProliantMicroserver" description="Local server of the house that stores and processes the raw sensor data." deploymentModel="Private" platform="Node.js, PostgreSQL, Mosquitto">
      <containsResource xsi:type="MonitorIoT:DataBase" isPartOf="//@containsIoTSystem.0/@containsIoTSubSystem.0 //@containsIoTSystem.0/@containsIoTSubSystem.1" id="3" name="PostgreSQLLocal" description="Local database with the raw data coming from the sensors." uri="postgresql://example_user:example_password@192.168.1.11:5432/local" user="example_user" password="example_password" usesProtocol="//@containsEntity.3/@containsProtocol.2">
        <containsDataTable name="HouseEnvironment" persistenceType="Permanent" hasLinkServiceToDatable="//@containsLink.5">
          <composedOfDataColumn name="temperature" hasRulePropertyToDataColumn="//@containsDataFlow.0/@containsDataMappingRule.0" dataType="Float" />
          <composedOfDataColumn name="carbonMonoxide" hasRulePropertyToDataColumn="//@containsDataFlow.0/@containsDataMappingRule.1" dataType="Float" />
          <composedOfDataColumn name="smoke" hasRulePropertyToDataColumn="//@containsDataFlow.0/@containsDataMappingRule.2" dataType="Float" />
          <composedOfDataColumn name="dateTime" dataColumnType="MetaData" dataType="Date" formulaExpression="return new Date().toISOString();" />
        </containsDataTable>
        <containsDataTable name="Health" persistenceType="Permanent" hasLinkServiceToDatable="//@containsLink.10 //@containsLink.11">
          <composedOfDataColumn name="heartRate" hasRulePropertyToDataColumn="//@containsDataFlow.1/@containsDataMappingRule.0" hasRuleAsSource="//@containsDataFlow.2/@containsDataMappingRule.0 //@containsDataFlow.2/@containsDataMappingRule.1 //@containsDataFlow.2/@containsDataMappingRule.2" dataType="Integer" />
          <composedOfDataColumn name="dateTime" dataColumnType="MetaData" dataType="Date" formulaExpression="return new Date().toISOString();" />
        </containsDataTable>
      </containsResource>
      <containsResource xsi:type="MonitorIoT:Middleware" isPartOf="//@containsIoTSystem.0/@containsIoTSubSystem.0 //@containsIoTSystem.0/@containsIoTSubSystem.1" id="4" name="Express" description="Application server that exposes the REST services." usesProtocol="//@containsEntity.3/@containsProtocol.0">
        <containsService id="5" name="saveEnvironmentData" endPoint="/environment" method="POST" hasLinkAppToService="//@containsLink.4" hasLinkServiceToDataTable="//@containsLink.5">
          <containsParameter ordinal="1" name="temperature" dataType="Float" receives="//@containsEntityCategory.0/@hasPropertyTemplate.0" />
          <containsParameter ordinal="2" name="carbonMonoxide" dataType="Float" receives="//@containsEntityCategory.0/@hasPropertyTemplate.1" />
          <containsParameter ordinal="3" name="smoke" dataType="Float" receives="//@containsEntityCategory.0/@hasPropertyTemplate.2" />
        </containsService>
        <containsService id="6" name="saveHealthData" endPoint="/health" method="POST" hasLinkServiceToDataTable="//@containsLink.10" hasLinkServiceToTopic="//@containsLink.9">
          <containsParameter ordinal="1" name="heartRate" dataType="Integer" receives="//@containsEntityCategory.1/@hasPropertyTemplate.0" />
        </containsService>
        <containsService id="7" name="saveHealthSummaryDaily" endPoint="/health-summary" method="POST" hasLinkServiceToDataTable="//@containsLink.11 //@containsLink.12" />
      </containsResource>
      <containsResource xsi:type="MonitorIoT:Broker" isPartOf="//@containsIoTSystem.0/@containsIoTSubSystem.1" id="8" name="Mosquitto" description="MQTT message broker." usesProtocol="//@containsEntity.3/@containsProtocol.1">
        <containsTopic incluyes="//@containsEntity.0/@containsSubPhysicalEntity.2/@hasProperty.0" id="9" name="healthData" hasLinkServiceToTopic="//@containsLink.9" hasLinkAppToTopic="//@containsLink.8" />
      </containsResource>
      <containsResource xsi:type="MonitorIoT:NetworkInterface" id="10" name="WiFiAdapter" connects="//@containsEntity.3" networkAddress="192.168.1.11" />
      <containsResource xsi:type="MonitorIoT:NetworkInterface" id="11" name="EthernetAdapter" connects="//@containsEntity.4" communicationTechnology="Ethernet" />
    </containsComputingNode>
    <containsComputingNode xsi:type="MonitorIoT:IoTGateway" isPartOf="//@containsIoTSystem.0/@containsIoTSubSystem.0" id="12" name="RaspberryPi3" description="Gateway that reads the room sensors through Bluetooth." controls="//@containsEntity.0/@containsSubPhysicalEntity.0/@containsComputingNode.0 //@containsEntity.0/@containsSubPhysicalEntity.1/@containsComputingNode.0" gatewayType="Microcontroller">
      <containsResource xsi:type="MonitorIoT:API" id="13" name="getTemperature" hasLinkAppToAPI="//@containsLink.2" hasLinkAPIToIoTDevice="//@containsLink.0">
        <containsReturnVariable ordinal="1" name="temperature" dataType="Float" returns="//@containsEntityCategory.0/@hasPropertyTemplate.0" />
      </containsResource>
      <containsResource xsi:type="MonitorIoT:API" id="14" name="getCOAndSmoke" hasLinkAppToAPI="//@containsLink.3" hasLinkAPIToIoTDevice="//@containsLink.1">
        <containsReturnVariable ordinal="1" name="carbonMonoxide" dataType="Float" returns="//@containsEntityCategory.0/@hasPropertyTemplate.1" />
        <containsReturnVariable ordinal="2" name="smoke" dataType="Float" returns="//@containsEntityCategory.0/@hasPropertyTemplate.2" />
      </containsResource>
      <containsResource xsi:type="MonitorIoT:Application" id="15" name="environmentController" type="Embedded" hasLinkAppToService="//@containsLink.4" hasLinkAppToAPI="//@containsLink.2 //@containsLink.3" />
      <containsResource xsi:type="MonitorIoT:NetworkInterface" id="16" name="BluetoothAdapter" connects="//@containsEntity.2" communicationTechnology="Bluetooth" />
      <containsResource xsi:type="MonitorIoT:NetworkInterface" id="17" name="WiFiAdapter" connects="//@containsEntity.3" />
    </containsComputingNode>
    <containsSubPhysicalEntity isPartOf="//@containsIoTSystem.0/@containsIoTSubSystem.0" id="18" name="Bedroom" isGrouped="//@containsEntityCategory.0">
      <hasProperty id="19" isBasedOn="//@containsEntityCategory.0/@hasPropertyTemplate.0" hasRulePropertyToDataColumn="//@containsDataFlow.0/@containsDataMappingRule.0" name="temperature" />
      <containsComputingNode xsi:type="MonitorIoT:Sensor" isPartOf="//@containsIoTSystem.0/@containsIoTSubSystem.0" id="20" name="TemperatureSensor" description="Ambient temperature sensor." isControlled="//@containsEntity.0/@containsComputingNode.1" hasLinkAPIToIoTDevice="//@containsLink.0" />
    </containsSubPhysicalEntity>
    <containsSubPhysicalEntity isPartOf="//@containsIoTSystem.0/@containsIoTSubSystem.0" id="21" name="Kitchen" isGrouped="//@containsEntityCategory.0">
      <hasProperty id="22" isBasedOn="//@containsEntityCategory.0/@hasPropertyTemplate.1" hasRulePropertyToDataColumn="//@containsDataFlow.0/@containsDataMappingRule.1" name="carbonMonoxide" />
      <hasProperty id="23" isBasedOn="//@containsEntityCategory.0/@hasPropertyTemplate.2" hasRulePropertyToDataColumn="//@containsDataFlow.0/@containsDataMappingRule.2" name="smoke" />
      <containsComputingNode xsi:type="MonitorIoT:Sensor" isPartOf="//@containsIoTSystem.0/@containsIoTSubSystem.0" id="24" name="COSmokeSensor" description="Carbon monoxide and smoke sensor." isControlled="//@containsEntity.0/@containsComputingNode.1" hasLinkAPIToIoTDevice="//@containsLink.1" />
    </containsSubPhysicalEntity>
    <containsSubPhysicalEntity xsi:type="MonitorIoT:HumanUser" isPartOf="//@containsIoTSystem.0/@containsIoTSubSystem.1" id="25" name="OlderAdult" description="Older adult who lives alone and wears a smartwatch." isGrouped="//@containsEntityCategory.1" interactsUsing="//@containsEntity.0/@containsSubPhysicalEntity.2/@containsComputingNode.0/@containsResource.1">
      <hasProperty id="26" isBasedOn="//@containsEntityCategory.1/@hasPropertyTemplate.0" isIncluded="//@containsEntity.0/@containsComputingNode.0/@containsResource.2/@containsTopic.0" hasRulePropertyToDataColumn="//@containsDataFlow.1/@containsDataMappingRule.0" name="heartRate" />
      <containsComputingNode xsi:type="MonitorIoT:IoTGateway" isPartOf="//@containsIoTSystem.0/@containsIoTSubSystem.1" id="27" name="SmartWatch" controls="//@containsEntity.0/@containsSubPhysicalEntity.2/@containsComputingNode.1" gatewayType="SmartWatch">
        <containsResource xsi:type="MonitorIoT:API" id="28" name="getHeartRate" hasLinkAppToAPI="//@containsLink.7" hasLinkAPIToIoTDevice="//@containsLink.6">
          <containsReturnVariable ordinal="1" name="heartRate" dataType="Integer" returns="//@containsEntityCategory.1/@hasPropertyTemplate.0" />
        </containsResource>
        <containsResource xsi:type="MonitorIoT:Application" id="29" name="healthMonitor" isUsedByUser="//@containsEntity.0/@containsSubPhysicalEntity.2" type="Mobile" hasLinkAppToAPI="//@containsLink.7" hasLinkAppToTopic="//@containsLink.8" />
        <containsResource xsi:type="MonitorIoT:NetworkInterface" id="30" name="WiFiAdapter" connects="//@containsEntity.3" />
      </containsComputingNode>
      <containsComputingNode xsi:type="MonitorIoT:Sensor" isPartOf="//@containsIoTSystem.0/@containsIoTSubSystem.1" id="31" name="HeartRateSensor" description="Optical heart rate sensor of the smartwatch." isControlled="//@containsEntity.0/@containsSubPhysicalEntity.2/@containsComputingNode.0" hasLinkAPIToIoTDevice="//@containsLink.6" />
    </containsSubPhysicalEntity>
  </containsEntity>
  <containsEntity xsi:type="MonitorIoT:CloudNode" isPartOf="//@containsIoTSystem.0/@containsIoTSubSystem.1" id="32" name="GoogleCloud" description="Cloud node that stores the daily health summary." serviceModel="PaaS" platform="PostgreSQL">
    <containsResource xsi:type="MonitorIoT:DataBase" isPartOf="//@containsIoTSystem.0/@containsIoTSubSystem.1" id="33" name="PostgreSQLCloud" uri="postgresql://example_user:example_password@cloud.example.com:5432/cloud" user="example_user" password="example_password" usesProtocol="//@containsEntity.4/@containsProtocol.1">
      <containsDataTable name="HealthSummaryDaily" persistenceType="Permanent" hasLinkServiceToDatable="//@containsLink.12">
