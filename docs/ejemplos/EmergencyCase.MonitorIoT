  </containsEntity>
  <containsEntity xsi:type="MonitorIoT:Network" isPartOf="//@containsIoTSystem.0/@containsIoTSubSystem.1" id="40" name="Internet" description="Connection between the house and the cloud." isConnected="//@containsEntity.0/@containsComputingNode.0/@containsResource.4 //@containsEntity.1/@containsResource.1">
    <containsProtocol id="41" name="HTTPS" port="443" />
    <containsProtocol isUsedByDataStore="//@containsEntity.1/@containsResource.0" id="42" name="PostgreSQL" port="5432" />
