    <containsIoTSubSystem isComposedOf="//@containsEntity.0 //@containsEntity.0/@containsSubPhysicalEntity.0 //@containsEntity.0/@containsSubPhysicalEntity.1 //@containsEntity.0/@containsComputingNode.0 //@containsEntity.0/@containsComputingNode.1 //@containsEntity.0/@containsSubPhysicalEntity.0/@containsComputingNode.0 //@containsEntity.0/@containsSubPhysicalEntity.1/@containsComputingNode.0 //@containsEntity.0/@containsComputingNode.0/@containsResource.0 //@containsEntity.0/@containsComputingNode.0/@containsResource.1 //@containsEntity.3 //@containsEntity.2" id="44" name="EnvironmentalControl" description="Monitors the temperature, carbon monoxide and smoke of the house." />
    <containsIoTSubSystem isComposedOf="//@containsEntity.0/@containsSubPhysicalEntity.2 //@containsEntity.0/@containsSubPhysicalEntity.2/@containsComputingNode.0 //@containsEntity.0/@containsSubPhysicalEntity.2/@containsComputingNode.1 //@containsEntity.0/@containsComputingNode.0 //@containsEntity.0/@containsComputingNode.0/@containsResource.0 //@containsEntity.0/@containsComputingNode.0/@containsResource.1 //@containsEntity.0/@containsComputingNode.0/@containsResource.2 //@containsEntity.1 //@containsEntity.1/@containsResource.0 //@containsEntity.3 //@containsEntity.4" id="45" name="HealthCare" description="Monitors the heart rate of the older adult and summarizes it daily in the cloud." />
  </containsIoTSystem>
  <containsDataFlow id="46" description="House environment data collection" isSupported="//@containsLink.0 //@containsLink.1 //@containsLink.2 //@containsLink.3 //@containsLink.4 //@containsLink.5" communicationType="Synchronous" unitOfTime="Minute" flowExecutionTimeInterval="10">
